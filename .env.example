# ============================================================
# OutreachPilot — Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in your API keys

# Ocean.io API — Company Lookalike Search
OCEAN_API_KEY=your_ocean_api_key_here
OCEAN_BASE_URL=https://api.ocean.io/v3

# OpenRouter API — Email Generation
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Prospeo API — Contact Discovery & Email Finder
PROSPEO_API_KEY=your_prospeo_api_key_here
PROSPEO_BASE_URL=https://api.prospeo.io

# Eazyreach API — Email Verification
EAZYREACH_API_KEY=your_eazyreach_api_key_here
EAZYREACH_TOKEN=your_eazyreach_token_here
EAZYREACH_BASE_URL=https://api.eazyreach.io/v1

# Brevo API — Transactional Email Sending
BREVO_API_KEY=your_brevo_api_key_here
BREVO_BASE_URL=https://api.brevo.com/v3
BREVO_SENDER_NAME=OutreachPilot
BREVO_SENDER_EMAIL=your-verified-sender@yourdomain.com

# Application Settings
APP_ENV=development
LOG_LEVEL=INFO
MAX_RETRIES=3
RETRY_BACKOFF_FACTOR=2
REQUEST_TIMEOUT=30
RATE_LIMIT_DELAY=1.0
MAX_COMPANIES=50
MAX_CONTACTS_PER_COMPANY=10

# Dashboard Settings
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
